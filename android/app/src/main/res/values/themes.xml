<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Kiez" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/kiez_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <style name="Theme.Kiez.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/kiez_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_anchor</item>
        <item name="postSplashScreenTheme">@style/Theme.Kiez</item>
    </style>
</resources>
